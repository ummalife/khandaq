<?xml version="1.0" encoding="utf-8"?>
<!-- Messenger UX metrics (Telegram-like layout). Colors = Khandaq identity only. -->
<resources>
    <!-- KHANDAQ: matches the light Figma chat wallpaper background (drawable-nodpi/chat_wallpaper.png) -->
    <color name="tg_chat_screen_bg">#DFEBE4</color>
    <color name="tg_bubble_incoming">@color/khandaq_bubble_in_light</color>
    <color name="tg_bubble_incoming_stroke">@color/khandaq_stroke_light</color>
    <color name="tg_bubble_outgoing">@color/khandaq_bubble_out_light</color>
    <color name="tg_bubble_text">@color/khandaq_graphite</color>
    <color name="tg_bubble_time_incoming">@color/khandaq_text_muted</color>
    <color name="tg_bubble_time_outgoing">#3D6B58</color>
    <color name="msg_status_grey">#94a3b8</color>
    <color name="msg_status_read">@color/khandaq_teal</color>
    <!-- KHANDAQ (Figma voice bubble): not-played waveform bars, visible on the light bubble -->
    <color name="voice_wave_unplayed">#66000000</color>
    <dimen name="msg_status_icon_size">14dp</dimen>
    <color name="tg_bubble_link">@color/khandaq_primary</color>
    <color name="tg_chat_input_bar_bg">#EEF2F0</color>
    <color name="tg_chat_input_field_bg">#F5F7F6</color>
    <color name="tg_chat_input_text">@color/khandaq_graphite</color>
    <color name="tg_chat_input_hint">@color/khandaq_text_muted</color>
    <color name="tg_date_separator_text">@color/khandaq_graphite</color>
    <color name="tg_date_separator_bg">#F0FFFFFF</color> <!-- KHANDAQ #155: opaque enough so the floating date pill stays readable over dark images -->

    <color name="tg_date_separator_line">#CCE0E0E0</color>
    <color name="tg_chat_header_bg">@color/tg_chat_bg</color>
    <color name="tg_chat_header_title">@color/khandaq_graphite</color>
    <color name="tg_chat_header_subtitle">@color/khandaq_text_muted</color>
    <color name="tg_chat_header_presence_online">@color/khandaq_primary</color>
    <color name="tg_chat_header_icon">@color/khandaq_primary</color>
    <color name="tg_voice_recording_dot">#FF3B30</color>
    <color name="tg_voice_recording_action">@color/khandaq_teal</color>
    <color name="tg_voice_recording_send_bg">@color/khandaq_teal</color>
    <!-- KHANDAQ (iOS #9): translucent teal halo behind the big record mic -->
    <color name="tg_voice_recording_halo">#33029B7D</color>
    <dimen name="tg_bubble_radius">16dp</dimen>
    <dimen name="tg_bubble_tail_radius">4dp</dimen>
    <dimen name="tg_bubble_padding_h">12dp</dimen>
    <dimen name="tg_bubble_padding_v">8dp</dimen>
    <dimen name="tg_bubble_text_size">16sp</dimen>
    <dimen name="tg_bubble_time_size">12sp</dimen>
    <dimen name="tg_bubble_peer_name_size">14sp</dimen>
    <dimen name="tg_bubble_time_pad_start">8dp</dimen>
    <dimen name="tg_bubble_time_pad_bottom">2dp</dimen>
    <dimen name="tg_peer_name_bubble_bottom">4dp</dimen>
    <dimen name="tg_avatar_bubble_gap">10dp</dimen>
    <dimen name="tg_chat_avatar_in_bubble">40dp</dimen>
    <dimen name="tg_message_row_v_margin">2dp</dimen>
    <dimen name="tg_message_margin_same_sender">4dp</dimen>
    <dimen name="tg_message_margin_diff_sender">12dp</dimen>
    <dimen name="tg_message_margin_system">4dp</dimen>
    <color name="tg_reply_preview_bg">#E8F0EC</color>
    <color name="tg_reply_preview_header">@color/khandaq_primary</color>
    <color name="tg_reply_preview_text">@color/khandaq_text_muted</color>
    <color name="tg_reply_quote_bg">#1A0F3D2E</color>
    <color name="tg_reply_quote_accent">@color/khandaq_primary</color>
    <color name="tg_reply_quote_name">@color/khandaq_primary</color>
    <color name="tg_reply_quote_text">@color/khandaq_text_muted</color>
</resources>
