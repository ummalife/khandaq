<?xml version="1.0" encoding="utf-8"?><!-- KHANDAQ (#192): reaction chips row under a message bubble -->
<!-- root MUST be match_parent: a wrap_content child inside the wrap_content bubble container
     flips LinearLayout's allFillParent flag and the bubble collapses to alternativeMaxWidth
     (= this row's width), crushing the text (LinearLayout.measureVertical semantics) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reactions_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="1dp"
    android:visibility="gone" />
