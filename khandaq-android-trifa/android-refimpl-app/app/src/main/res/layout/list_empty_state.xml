<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/list_empty_state"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="48dp"
    android:paddingEnd="32dp"
    android:paddingBottom="48dp"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/list_empty_icon"
        android:layout_width="@dimen/list_empty_state_icon_size"
        android:layout_height="@dimen/list_empty_state_icon_size"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        app:tint="@color/list_empty_state_icon"
        tools:srcCompat="@drawable/ic_empty_chats" />

    <TextView
        android:id="@+id/list_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="@color/tg_chat_title"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="No chats" />

    <TextView
        android:id="@+id/list_empty_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:maxWidth="300dp"
        android:textColor="@color/tg_chat_preview"
        android:textSize="14sp"
        tools:text="Add a contact to start chatting" />

    <TextView
        android:id="@+id/list_empty_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:textColor="@color/khandaq_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Start chat"
        tools:visibility="visible" />

</LinearLayout>
