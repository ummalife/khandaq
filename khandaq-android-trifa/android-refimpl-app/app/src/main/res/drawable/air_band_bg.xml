<?xml version="1.0" encoding="utf-8"?>
<!-- KHANDAQ (redesign, E22): the in-app band's ground, with the sheet radius: the raised surface, sunken
     while pressed, as an Air row is. Its shape also gives the outline that casts the "lift" shadow. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="@integer/kq_dur_tap">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kq_sunken" />
            <corners android:radius="@dimen/kq_radius_sheet" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kq_raised" />
            <corners android:radius="@dimen/kq_radius_sheet" />
        </shape>
    </item>
</selector>
