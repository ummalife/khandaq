		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld системное сообщение</string>
			<key>few</key>
			<string>%ld системных сообщения</string>
			<key>many</key>
			<string>%ld системных сообщений</string>
			<key>other</key>
			<string>%ld системного сообщения</string>
		</dict>
	</dict>
