<?xml version="1.0" encoding="utf-8"?>
<!-- The one main action of a place: ink; sunken and grey while it may not go. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="@integer/kq_dur_tap">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/kq_sunken" />
            <stroke android:width="@dimen/kq_stroke_hairline" android:color="@color/kq_line" />
            <corners android:radius="@dimen/kq_radius_control" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kq_ink_pressed" />
            <stroke android:width="@dimen/kq_stroke_hairline" android:color="@color/kq_ink_pressed" />
            <corners android:radius="@dimen/kq_radius_control" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kq_ink" />
            <stroke android:width="@dimen/kq_stroke_focus" android:color="@color/kq_focus" />
            <corners android:radius="@dimen/kq_radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kq_ink" />
            <stroke android:width="@dimen/kq_stroke_hairline" android:color="@color/kq_ink" />
            <corners android:radius="@dimen/kq_radius_control" />
        </shape>
    </item>
</selector>
