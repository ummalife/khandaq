<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/pref_header_general">
        <ListPreference
            android:defaultValue="0"
            android:entries="@array/pref_dark_mode_titles"
            android:entryValues="@array/pref_dark_mode_values"
            android:key="dark_mode_pref"
            android:summary="@string/pref_description_dark_mode"
            android:title="@string/pref_title_dark_mode" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="start_on_boot"
            android:summary="@string/air_pref_start_after_restart_summary"
            android:title="@string/air_pref_start_after_restart_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="compact_friendlist"
            android:summary="@string/pref_description_compact_friendlist"
            android:title="@string/pref_title_compact_friendlist" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="use_incognito_keyboard"
            android:summary="@string/air_pref_incognito_summary"
            android:title="@string/air_pref_incognito_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="window_security"
            android:summary="@string/air_pref_screenshots_summary"
            android:title="@string/air_pref_screenshots_title" />

        <EditTextPreference
            android:defaultValue="50"
            android:inputType="number"
            android:key="message_paging_num_msgs_per_page"
            android:maxLength="3"
            android:numeric="integer"
            android:summary="@string/air_pref_page_size_summary"
            android:title="@string/air_pref_page_size_title" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="auto_accept_image"
            android:summary="@string/air_pref_accept_pictures_summary"
            android:title="@string/air_pref_accept_pictures_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="auto_accept_video"
            android:summary="@string/air_pref_accept_videos_summary"
            android:title="@string/air_pref_accept_videos_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="auto_accept_all_upto"
            android:summary="@string/air_pref_accept_files_summary"
            android:title="@string/air_pref_accept_files_title" />

        <!-- set default value to PREF_GLOBAL_FONT_SIZE_DEFAULT -->
        <ListPreference
            android:defaultValue="2"
            android:entries="@array/air_pref_font_size_entries"
            android:entryValues="@array/pref_global_font_size_values"
            android:key="global_font_size"
            android:negativeButtonText="@null"
            android:positiveButtonText="@null"
            android:summary="@string/air_pref_font_size_summary"
            android:title="@string/air_pref_font_size_title" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="allow_file_sharing_to_trifa_via_intent"
            android:summary="@string/air_pref_share_in_summary"
            android:title="@string/air_pref_share_in_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="allow_open_encrypted_file_via_intent"
            android:summary="@string/air_pref_open_out_summary"
            android:title="@string/air_pref_open_out_title" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="video_uv_reversed"
            android:summary="@string/air_pref_swap_colours_summary"
            android:title="@string/air_pref_swap_colours_title" />

        <ListPreference
            android:defaultValue="YV12"
            android:entries="@array/air_pref_picture_format_entries"
            android:entryValues="@array/pref_camera_get_preview_format_values"
            android:key="camera_get_preview_format"
            android:negativeButtonText="@null"
            android:positiveButtonText="@null"
            android:summary="@string/air_pref_picture_format_summary"
            android:title="@string/air_pref_picture_format_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="use_H264_hw_encoding"
            android:summary="@string/air_pref_video_chip_summary"
            android:title="@string/air_pref_video_chip_title" />

        <!--<SwitchPreference-->
        <!--android:defaultValue="true"-->
        <!--android:key="software_echo_cancel"-->
        <!--android:summary="@string/pref_description_software_echo_cancel"-->
        <!--android:title="@string/pref_title_software_echo_cancel"/>-->

        <SwitchPreference
            android:defaultValue="false"
            android:key="orbot_enabled"
            android:summary="@string/air_pref_tor_summary"
            android:title="@string/air_pref_tor_title" />

        <ListPreference
            android:defaultValue="0"
            android:entries="@array/air_pref_resolution_entries"
            android:entryValues="@array/pref_video_cam_resolution_values"
            android:key="video_cam_resolution"
            android:negativeButtonText="@null"
            android:positiveButtonText="@null"
            android:summary="@string/air_pref_resolution_summary"
            android:title="@string/air_pref_resolution_title" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="h264_encoder_use_intra_refresh"
            android:summary="@string/air_pref_gradual_refresh_summary"
            android:title="@string/air_pref_gradual_refresh_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="fps_half"
            android:summary="@string/air_pref_fewer_frames_summary"
            android:title="@string/air_pref_fewer_frames_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="set_fps"
            android:summary="@string/air_pref_camera_fps_summary"
            android:title="@string/air_pref_camera_fps_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="speakerphone_tweak"
            android:summary="@string/pref_description_speakerphone_tweak"
            android:title="@string/pref_title_speakerphone_tweak" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="allow_screen_off_in_audio_call"
            android:summary="@string/air_pref_screen_off_summary"
            android:title="@string/air_pref_screen_off_title" />

        <SeekBarPreference
            android:defaultValue="1"
            android:key="mic_gain_factor"
            android:max="30"
            android:min="1"
            android:summary="@string/air_pref_mic_boost_summary"
            android:title="@string/air_pref_mic_boost_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="mic_gain_factor_toggle"
            android:summary="@string/air_pref_boost_lowers_summary"
            android:title="@string/air_pref_boost_lowers_title" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="gainprocessing_active"
            android:summary="@string/air_pref_auto_level_summary"
            android:title="@string/air_pref_auto_level_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="rnnoise_active"
            android:summary="@string/air_pref_noise_summary"
            android:title="@string/air_pref_noise_title" />

        <ListPreference
            android:defaultValue="2"
            android:entries="@array/air_pref_call_quality_entries"
            android:entryValues="@array/pref_higher_audio_quality_values"
            android:key="higher_audio_quality"
            android:negativeButtonText="@null"
            android:positiveButtonText="@null"
            android:summary="@string/air_pref_call_quality_summary"
            android:title="@string/air_pref_call_quality_title" />
        <ListPreference
            android:defaultValue="48000"
            android:entries="@array/pref_min_audio_samplingrate_out_titles"
            android:entryValues="@array/pref_min_audio_samplingrate_out_values"
            android:key="min_audio_samplingrate_out"
            android:negativeButtonText="@null"
            android:positiveButtonText="@null"
            android:summary="@string/pref_description_min_audio_samplingrate_out"
            android:title="@string/pref_title_min_audio_samplingrate_out" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="conference_show_system_messages"
            android:summary="@string/air_pref_group_notes_summary"
            android:title="@string/air_pref_group_notes_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="local_discovery_enabled"
            android:summary="@string/pref_description_local_discovery_enabled"
            android:title="@string/pref_title_local_discovery_enabled" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="udp_enabled"
            android:summary="@string/pref_description_udp_enabled"
            android:title="@string/pref_title_udp_enabled" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="force_udp_only"
            android:summary="@string/air_pref_direct_only_summary"
            android:title="@string/air_pref_direct_only_title" />

        <EditTextPreference
            android:defaultValue=""
            android:key="toxirc_muted_peers_01"
            android:maxLength="100"
            android:singleLine="true"
            android:summary="@string/air_pref_irc_name_1_summary"
            android:title="@string/air_pref_irc_name_1_title" />

        <EditTextPreference
            android:defaultValue=""
            android:key="toxirc_muted_peers_02"
            android:maxLength="100"
            android:singleLine="true"
            android:summary="@string/air_pref_irc_name_more_summary"
            android:title="@string/air_pref_irc_name_2_title" />

        <EditTextPreference
            android:defaultValue=""
            android:key="toxirc_muted_peers_03"
            android:maxLength="100"
            android:singleLine="true"
            android:summary="@string/air_pref_irc_name_more_summary"
            android:title="@string/air_pref_irc_name_3_title" />

    </PreferenceCategory>

    <PreferenceCategory android:key="cat_dev_network" android:title="network">
        <Preference
            android:key="custom_bootstrap_nodes"
            android:summary="__"
            android:title="@string/pref_title_custom_bootstrap_nodes" />
    </PreferenceCategory>

    <PreferenceCategory android:key="cat_dev_unsafe" android:title="! unsafe !">

        <SwitchPreference
            android:defaultValue="false"
            android:key="U_keep_nospam"
            android:summary="@string/pref_description_U_keep_nospam"
            android:title="@string/pref_title_U_keep_nospam" />

    </PreferenceCategory>


    <PreferenceCategory android:key="cat_dev_experimental" android:title="! eXperimental !">

        <EditTextPreference
            android:defaultValue="80"
            android:inputType="number"
            android:key="X_eac_delay_ms_2"
            android:maxLength="3"
            android:numeric="integer"
            android:summary="@string/pref_description_X_eac_delay_ms"
            android:title="@string/pref_title_X_eac_delay_ms" />

        <EditTextPreference
            android:defaultValue="0"
            android:inputType="number"
            android:key="X_audio_play_buffer_custom"
            android:maxLength="6"
            android:numeric="integer"
            android:summary="@string/pref_description_X_audio_play_buffer_custom"
            android:title="@string/pref_title_X_audio_play_buffer_custom" />

        <ListPreference
            android:defaultValue="40"
            android:entries="@array/X_audio_recording_frame_size_titles"
            android:entryValues="@array/X_audio_recording_frame_size_values"
            android:key="X_audio_recording_frame_size"
            android:negativeButtonText="@null"
            android:positiveButtonText="@null"
            android:summary="@string/pref_description_X_audio_recording_frame_size"
            android:title="@string/pref_title_X_audio_recording_frame_size" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="X_battery_saving_mode"
            android:summary="@string/pref_description_X_battery_saving_mode"
            android:title="@string/pref_title_X_battery_saving_mode" />

        <ListPreference
            android:defaultValue="15"
            android:dependency="X_battery_saving_mode"
            android:entries="@array/X_battery_saving_timeout_titles"
            android:entryValues="@array/X_battery_saving_timeout_values"
            android:key="X_battery_saving_timeout"
            android:negativeButtonText="@null"
            android:positiveButtonText="@null"
            android:summary="@string/pref_description_X_battery_saving_timeout"
            android:title="@string/pref_title_X_battery_saving_timeout" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="X_misc_button_enabled"
            android:summary="@string/pref_description_X_misc_button_enabled"
            android:title="@string/pref_title_X_misc_button_enabled" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="X_tox_set_do_not_sync_av"
            android:summary="@string/pref_description_X_tox_set_do_not_sync_av"
            android:title="@string/pref_title_X_tox_set_do_not_sync_av" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="X_zoom_incoming_video"
            android:summary="@string/pref_description_X_zoom_incoming_video"
            android:title="@string/pref_title_X_zoom_incoming_video" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_header_general">
        <Preference
            android:key="network_diagnostics"
            android:summary="@string/air_network_log_note"
            android:title="@string/air_network_log" />
    </PreferenceCategory>
</PreferenceScreen>
