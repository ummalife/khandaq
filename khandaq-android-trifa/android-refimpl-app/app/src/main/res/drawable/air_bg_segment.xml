<?xml version="1.0" encoding="utf-8"?>
<!-- The segmented control: a sunken well drawn 36dp high inside its 48dp touch row. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="@dimen/kq_space_6"
    android:insetBottom="@dimen/kq_space_6">
    <shape android:shape="rectangle">
        <solid android:color="@color/kq_sunken" />
        <corners android:radius="@dimen/kq_radius_field" />
    </shape>
</inset>
