<?xml version="1.0" encoding="utf-8"?>
<!--
    KHANDAQ (redesign, stage 3b): the transcript of a group, as the conversation with one person
    (message_list_layout): the surface of the screen with no wallpaper under it; the day floats over the
    top edge while the list scrolls. Every id and onClick handler of the old layout except the wallpaper
    is kept.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_surface">

    <com.l4digital.fastscroll.FastScrollRecyclerView
        android:id="@+id/msg_rv_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="@dimen/kq_space_4"
        android:paddingBottom="@dimen/kq_space_8"
        app:bubbleColor="@color/kq_ink"
        app:bubbleSize="small"
        app:bubbleTextColor="@color/kq_on_ink"
        app:bubbleTextSize="14sp"
        app:handleColor="@color/kq_line_strong"
        app:hideScrollbar="true"
        app:showTrack="false"
        app:trackColor="@color/kq_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/scroll_date_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="@dimen/kq_space_6"
            android:background="@drawable/air_bg_day_float"
            android:gravity="center"
            android:paddingStart="@dimen/kq_space_8"
            android:paddingTop="@dimen/kq_space_2"
            android:paddingEnd="@dimen/kq_space_8"
            android:paddingBottom="@dimen/kq_space_2"
            android:text=""
            android:textAppearance="@style/TextAppearance.KQ.Air.CaptionMedium"
            android:textColor="@color/kq_ink_2"
            android:visibility="invisible" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/unread_messages_notice_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/kq_space_16"
        android:layout_marginBottom="@dimen/kq_space_16"
        android:contentDescription="@string/air_chat_jump_latest"
        android:onClick="scroll_to_bottom"
        android:visibility="invisible"
        app:backgroundTint="@color/kq_raised"
        app:borderWidth="0dp"
        app:elevation="2dp"
        app:fabSize="mini"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.KQ.Air.Control"
        app:srcCompat="@drawable/kq_ic_chevron_down"
        app:tint="@color/kq_ink_2" />

</RelativeLayout>
