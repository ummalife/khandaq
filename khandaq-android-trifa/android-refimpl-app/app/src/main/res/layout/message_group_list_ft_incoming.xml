<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="wrap_content"
    android:layout_width="fill_parent"
    android:padding="@dimen/message_entry_padding">

    <LinearLayout
        android:id="@+id/layout_message_container"
        android:layout_below="@+id/message_text_date"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:padding="0dp">

        <LinearLayout
            android:id="@+id/layout_peer_name_container"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/message_peer_name_bottom_padding"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:gravity="left"
                android:id="@+id/peer_name_text"
                android:layout_gravity="center"
                android:layout_height="wrap_content"
                android:layout_marginLeft="65dp"
                android:layout_width="match_parent"
                android:text="@string/layout___peer_name"
                android:textColor="#EFEFEF"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout2"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="horizontal">

            <de.hdodenhof.circleimageview.CircleImageView
                android:gravity="top"
                android:id="@+id/img_avatar"
                android:layout_height="50dp"
                android:layout_marginTop="0dp"
                android:layout_weight="3"
                android:layout_width="75dp"
                android:src="@drawable/user_pratikshya"
                app:civ_border_color="#50000000"
                app:civ_border_width="2dp"
                app:civ_fill_color="@color/md_grey_400" />

            <ImageView
                android:alpha="0.5"
                android:id="@+id/img_corner"
                android:layout_height="30dp"
                android:layout_marginRight="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:layout_width="30dp"
                android:src="@drawable/arrow_bg2" />

            <LinearLayout
                android:id="@+id/m_container"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="20dp"
                android:layout_weight="6"
                android:layout_width="fill_parent"
                android:minHeight="0dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/m_icon"
                    android:layout_alignParentTop="true"
                    android:layout_height="20dp"
                    android:layout_marginRight="6dip"
                    android:layout_width="20dp"
                    android:padding="2dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/circle_red"
                    android:visibility="invisible" />

                <com.luseen.autolinklibrary.EmojiTextViewLinks
                    android:id="@+id/m_text"
                    android:layout_height="0dp"
                    android:layout_width="0dp"
                    android:paddingBottom="3dp"
                    android:text=""
                    android:textColor="@color/message_bubble_text"
                    android:textColorLink="@color/textblock_link_color_for_orange"
                    android:textSize="20sp"
                    app:emojiSize="@dimen/emoji_size_in_textview" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="0dp"
                    android:orientation="horizontal">

                    <com.daimajia.numberprogressbar.NumberProgressBar
                        android:id="@+id/ft_progressbar"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical|center_horizontal"
                        android:minHeight="24dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:visibility="gone"

                        app:progress_max="100"
                        app:progress_reached_bar_height="15dp"
                        app:progress_reached_color="@color/khandaq_teal"
                        app:progress_text_color="@color/md_always_black_1000"
                        app:progress_text_offset="5dp"
                        app:progress_text_size="12sp"
                        app:progress_text_visibility="visible"
                        app:progress_unreached_bar_height="4dp"
                        app:progress_unreached_color="#66CCCCCC" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ft_preview_container"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="0dp"
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <me.jagar.chatvoiceplayerlibrary.VoicePlayerView
                        android:id="@+id/ft_audio_player"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        app:enableVisualizer="true"
                        app:visualizationPlayedColor="@color/khandaq_teal"
                        app:visualizationNotPlayedColor="@color/voice_wave_unplayed"
                        app:playPauseBackgroundColor="@color/khandaq_teal"
                        app:seekBarThumbColor="@color/khandaq_teal"
                        app:showShareButton="false"
                        app:showTiming="true"
                        app:playPauseCornerRadius="100"
                        app:viewCornerRadius="16"
                        app:viewBackground="@color/tg_bubble_incoming"
                        app:progressTimeColor="@color/tg_bubble_time_incoming"
                        app:timingBackgroundColor="@android:color/transparent"
                        android:visibility="gone" />

                    <ImageButton
                        android:background="@android:color/transparent"
                        android:id="@+id/ft_preview_image"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="0dp"
                        android:layout_marginRight="0dp"
                        android:layout_width="match_parent"
                        android:minHeight="1dp"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@null"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/ft_caption_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="6dp"
                        android:autoLink="web"
                        android:textColor="@color/message_bubble_text"
                        android:textSize="16sp"
                        android:visibility="gone" />

                    <include layout="@layout/chat_file_attachment_row" />

                </LinearLayout>

                <!-- KHANDAQ (#206): reactions row hoisted to bubble level (was nested inside the
                     gone-by-default ft_preview_container, which clipped chips on non-image/paused files). -->
                <include layout="@layout/chat_reactions_row" />

                <TextView
                    android:id="@+id/bubble_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:includeFontPadding="false"
                    android:text="02:09"
                    android:textColor="@color/tg_bubble_time_incoming"
                    android:textSize="@dimen/tg_bubble_time_size"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/dummy"
                    android:layout_height="wrap_content"
                    android:layout_width="10dp"
                    android:text=""
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:padding="0dp">

            <TextView
                android:layout_height="1dp"
                android:layout_weight="10"
                android:layout_width="0dp"
                android:visibility="invisible" />

            <TextView
                android:gravity="top"
                android:id="@+id/date_time"
                android:layout_gravity="top"
                android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/message_entry_datetime_bottom_padding"
            android:layout_marginRight="20dp"
            android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:padding="0dp"
                android:text="2017-06-20 14:00:12"
                android:textAlignment="gravity"
                android:textColor="#EFEFEF"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/message_text_date"
        android:layout_alignParentTop="true"
        android:layout_centerInParent="true"
        android:layout_height="35dp"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:background="@color/tg_date_separator_line"
            android:layout_gravity="center_vertical"
            android:layout_height="2dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="100"
            android:layout_width="wrap_content" />

        <TextView
            android:background="@drawable/rounded_date_bg"
            android:id="@+id/message_text_date_string"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="5dp"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:paddingBottom="2dp"
            android:paddingEnd="@dimen/padding_small"
            android:paddingLeft="@dimen/padding_small"
            android:paddingRight="@dimen/padding_small"
            android:paddingStart="@dimen/padding_small"
            android:paddingTop="2dp"
            android:text="2017-05-14"
            android:textColor="@color/message_text_date_string_color"
            android:textSize="@dimen/text_small" />

        <ImageView
            android:background="@color/tg_date_separator_line"
            android:layout_gravity="center_vertical"
            android:layout_height="2dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="100"
            android:layout_width="wrap_content" />

    </LinearLayout>
</RelativeLayout>



