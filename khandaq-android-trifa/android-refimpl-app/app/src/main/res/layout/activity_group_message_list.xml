<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context="com.zoffcc.applications.trifa.GroupMessageListActivity">

    <!-- KHANDAQ: single-row group chat header (Figma): back(nav) + avatar + name/count + ⋮ overflow.
         Members / add-person / video / search live in the ⋮ menu (menu_group_chat_header). -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tg_chat_header_bg"
        android:minHeight="?attr/actionBarSize"
        app:contentInsetStartWithNavigation="0dp"
        app:popupTheme="@style/KhandaqPopupOverlay"
        app:theme="@style/ThemeOverlay.AppCompat.DayNight.ActionBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ml_header_group_info_tap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="@string/group_open_group_info"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ml_group_avatar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="8dp"
                    app:civ_circle_background_color="@color/khandaq_teal" />

                <ImageView
                    android:id="@+id/ml_icon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/circle_red"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ml_status_icon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/circle_green"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ml_maintext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingStart="2dp"
                    android:paddingEnd="6dp"
                    android:text="@string/layout___name"
                    android:textColor="@color/tg_chat_header_title"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- search revealed from the ⋮ overflow; fills the row when active -->
            <androidx.appcompat.widget.SearchView
                android:id="@+id/group_search_view_messages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:focusable="false"
                android:visibility="gone"
                app:iconifiedByDefault="false" />

            <!-- moved to the ⋮ overflow (kept, hidden, for their ids/onClick) -->
            <ImageButton
                android:id="@+id/ml_members_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@null"
                android:contentDescription="@string/group_open_member_list"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/add_friend_conference"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@null"
                android:onClick="show_add_friend_group"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/ml_phone_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@null"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/ml_video_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@null"
                android:onClick="toggle_group_video"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- the layout which will contain (host) the drawerLayout -->
    <FrameLayout
        android:id="@+id/drawer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ngc_video_view_container"
                android:layout_width="match_parent"
                android:layout_height="440dp"
                android:background="@color/md_always_black_1000"
                android:orientation="horizontal"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="left"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="1dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:gravity="center_horizontal|bottom"
                        android:text="O"
                        android:textColor="@color/md_white_1000"
                        android:textSize="11sp" />

                    <com.google.speech.levelmeter.BarLevelDrawable
                        android:id="@+id/ngc_audio_bar_in_v"
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="30dp"
                        android:elevation="10dp" />
                </LinearLayout>

                <com.zoffcc.applications.trifa.CustomVideoImageView
                    android:id="@+id/ngc_video_view"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="0dp"
                    android:layout_weight="140"
                    android:background="@color/md_always_black_1000" />

                <LinearLayout
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="1dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:gravity="center_horizontal|bottom"
                        android:text="I"
                        android:textColor="@color/md_white_1000"
                        android:textSize="11sp" />

                    <com.google.speech.levelmeter.BarLevelDrawable
                        android:id="@+id/ngc_audio_bar_out_v"
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="30dp"
                        android:elevation="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="50"
                    android:background="@color/md_always_black_1000"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <com.zoffcc.applications.trifa.CustomVideoImageView
                        android:id="@+id/ngc_video_own_view"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="35"
                        android:background="@color/md_always_black_1000"
                        tools:ignore="NestedWeights" />

                    <TextView
                        android:id="@+id/ngc_camera_info_text"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="28"
                        android:background="@android:color/transparent"
                        android:text=""
                        android:textColor="@color/textColorPrimary" />

                    <ImageButton
                        android:id="@+id/ngc_camera_next_button"
                        android:layout_width="@dimen/calling_activity_bottom_buttons_small_height"
                        android:layout_height="@dimen/calling_activity_bottom_buttons_small_height"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true"
                        android:keepScreenOn="true"
                        android:scaleType="fitXY"
                        android:src="@drawable/circle_blue" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="4"
                        android:background="@android:color/transparent"
                        android:text="" />

                    <ImageButton
                        android:id="@+id/ngc_video_off_button"
                        android:layout_width="@dimen/calling_activity_bottom_buttons_small_height"
                        android:layout_height="@dimen/calling_activity_bottom_buttons_small_height"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true"
                        android:keepScreenOn="true"
                        android:scaleType="fitXY"
                        android:src="@drawable/circle_green" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="4"
                        android:background="@android:color/transparent"
                        android:text="" />

                    <ImageButton
                        android:id="@+id/ngc_mute_button"
                        android:layout_width="@dimen/calling_activity_bottom_buttons_small_height"
                        android:layout_height="@dimen/calling_activity_bottom_buttons_small_height"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true"
                        android:keepScreenOn="true"
                        android:scaleType="fitXY"
                        android:src="@drawable/circle_green" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="4"
                        android:background="@android:color/transparent"
                        android:text="" />

                    <ImageButton
                        android:id="@+id/ngc_video_quality_toggle_button"
                        android:layout_width="@dimen/calling_activity_bottom_buttons_small_height"
                        android:layout_height="@dimen/calling_activity_bottom_buttons_small_height"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true"
                        android:keepScreenOn="true"
                        android:scaleType="fitXY"
                        android:src="@drawable/circle_orange" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="4"
                        android:background="@android:color/transparent"
                        android:text="" />

                    <ImageButton
                        android:id="@+id/ngc_camera_toggle_button"
                        android:layout_width="@dimen/calling_activity_bottom_buttons_small_height"
                        android:layout_height="@dimen/calling_activity_bottom_buttons_small_height"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true"
                        android:keepScreenOn="true"
                        android:scaleType="fitXY"
                        android:src="@drawable/circle_blue" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="3"
                        android:background="@android:color/transparent"
                        android:text="" />

                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="0dp">

                <fragment
                    android:id="@+id/ml_fragment"
                    android:name="com.zoffcc.applications.trifa.GroupMessageListFragment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:layout="@layout/group_message_list_layout" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:layout_gravity="bottom"
                android:layout_weight="0"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ml_friend_typing"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:cursorVisible="true"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@android:color/primary_text_light"
                    android:textSize="12sp"
                    tools:ignore="NestedWeights" />
            </LinearLayout>

            <include layout="@layout/chat_reply_preview_bar" />

            <FrameLayout
                android:id="@+id/emoji_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/chat_input_bar_margin_h"
                android:layout_marginEnd="@dimen/chat_input_bar_margin_h"
                android:layout_marginBottom="@dimen/chat_input_bar_margin_bottom"
                android:layout_weight="0"
                android:background="@drawable/bg_chat_input_bar"
                android:paddingStart="@dimen/chat_input_bar_padding_h"
                android:paddingTop="@dimen/chat_input_bar_padding_v"
                android:paddingEnd="@dimen/chat_input_bar_padding_h"
                android:paddingBottom="@dimen/chat_input_bar_padding_v">

                <LinearLayout
                    android:id="@+id/emoji_bar_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/insert_emoji"
                    android:layout_width="@dimen/chat_input_icon_size"
                    android:layout_height="@dimen/chat_input_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="@dimen/chat_input_icon_margin"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/chat_input_icon_padding"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/i_emoji_google_category_people"
                    tools:ignore="ContentDescription" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_message_field">

                <com.vanniktech.emoji.EmojiEditText
                    android:id="@+id/ml_new_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@android:color/transparent"
                    android:backgroundTint="@null"
                    android:cursorVisible="true"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:imeOptions="flagNoPersonalizedLearning|actionSend"
                    android:includeFontPadding="false"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:paddingStart="@dimen/chat_input_field_padding_h"
                    android:paddingTop="@dimen/chat_input_field_padding_v"
                    android:paddingEnd="@dimen/chat_input_field_padding_h"
                    android:paddingBottom="@dimen/chat_input_field_padding_v"
                    android:singleLine="false"
                    android:text=""
                    android:textColor="@color/tg_chat_input_text"
                    android:textColorHint="@color/tg_chat_input_hint"
                    android:textSize="@dimen/chat_input_text_size"
                    tools:ignore="NestedWeights" />

                </FrameLayout>

                <ImageButton
                    android:id="@+id/ml_button_01"
                    android:layout_width="@dimen/chat_input_icon_size"
                    android:layout_height="@dimen/chat_input_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="@dimen/chat_input_icon_margin"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:padding="@dimen/chat_input_icon_padding"
                    android:scaleType="fitCenter"
                    tools:ignore="ContentDescription" />

                <ImageButton
                    android:id="@+id/ml_button_recaudio"
                    android:layout_width="@dimen/chat_input_icon_size"
                    android:layout_height="@dimen/chat_input_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="@dimen/chat_input_icon_margin"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/chat_input_icon_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/baseline_keyboard_voice_24" />

                </LinearLayout>

                <include layout="@layout/chat_voice_recording_bar" />

            </FrameLayout>

        </LinearLayout>

        <!--<include layout="@layout/floating_action_button_group" />-->

    </FrameLayout>

</LinearLayout>


