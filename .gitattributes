# KHANDAQ (audit #2, repo hygiene): the repo had no .gitattributes, so on Windows a
# clone with core.autocrlf=true rewrote every shell script to CRLF and they then failed
# to run under WSL/MSYS ("bad interpreter: /bin/bash^M"). Force LF on everything that is
# executed by a POSIX shell/interpreter or consumed by a build tool, force CRLF where
# Windows requires it, and mark known binaries so git never touches or diffs them.
#
# Deliberately NOT using a blanket `* text=auto`: C/C++ sources are left alone because
# vendored third-party trees (webrtc, toxcore) carry CRLF files whose blobs must not be
# renormalized. Subdirectory .gitattributes (khandaq-android, khandaq-desktop,
# khandaq-ios) still win over this file for their own trees.

# --- Shell / interpreted scripts: must stay LF or they do not execute -----------------
*.sh            text eol=lf
*.bash          text eol=lf
*.zsh           text eol=lf
*.command       text eol=lf
*.py            text eol=lf
*.pl            text eol=lf
*.rb            text eol=lf
*.awk           text eol=lf
*.sed           text eol=lf
configure       text eol=lf
gradlew         text eol=lf
bootstrap       text eol=lf

# --- Patch / diff scripts: a CRLF patch no longer applies ----------------------------
*.patch         text eol=lf
*.diff          text eol=lf

# --- Build definitions read by Linux/macOS toolchains --------------------------------
*.gradle        text eol=lf
*.gradle.kts    text eol=lf
*.properties    text eol=lf
*.cmake         text eol=lf
CMakeLists.txt  text eol=lf
Makefile        text eol=lf
*.mk            text eol=lf
*.am            text eol=lf
*.m4            text eol=lf
*.bazel         text eol=lf
*.bzl           text eol=lf
BUILD           text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.spec          text eol=lf
*.desktop       text eol=lf
*.service       text eol=lf
*.pc            text eol=lf

# --- CI / config that is parsed on Linux ---------------------------------------------
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.cfg           text eol=lf
*.conf          text eol=lf
*.ini           text eol=lf
*.sha256        text eol=lf
.editorconfig   text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf
.gitmodules     text eol=lf

# --- Windows-native scripts: these genuinely need CRLF -------------------------------
# `-text` (not `text eol=crlf`): the tracked gradlew.bat blob is already CRLF, and any
# `text` marking would make git renormalize it to LF in the index. -text pins the bytes
# exactly as committed, on every platform, so this file changes nothing that ships.
*.bat           -text
*.cmd           -text

# --- Binaries: never convert, never diff ---------------------------------------------
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.tiff          binary
*.ico           binary
*.icns          binary
*.pdf           binary
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.jar           binary
*.aar           binary
*.apk           binary
*.aab           binary
*.so            binary
*.a             binary
*.dylib         binary
*.dll           binary
*.exe           binary
*.zip           binary
*.gz            binary
*.xz            binary
