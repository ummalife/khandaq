<?xml version="1.0" encoding="utf-8"?>
<!--
    KHANDAQ Advanced settings (redesign, stage 3b): one scrolling column that
    SettingsActivity.GeneralPreferenceFragment fills with AirScreenKit sections drawn from the old
    preferences. PreferenceFragment binds its preferences, their dependencies included, to a ListView
    with the id android:id/list; that list stays hidden and the column shows the same preferences.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg">

    <ScrollView
        android:id="@+id/air_pref_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/air_pref_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/kq_space_16"
            android:paddingTop="@dimen/kq_space_8"
            android:paddingEnd="@dimen/kq_space_16"
            android:paddingBottom="@dimen/kq_space_32" />
    </ScrollView>

    <ListView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
