<?xml version="1.0" encoding="utf-8"?>
<!-- KHANDAQ (redesign stage 4, E20): Delete on the PIN keypad: a word in the place of a key, nothing at
     rest, the sunken circle while pressed, the focus ring under a keyboard. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="@integer/kq_dur_tap">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/kq_sunken" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="@dimen/kq_stroke_focus" android:color="@color/kq_focus" />
        </shape>
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
