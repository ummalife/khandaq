[Unit]
Description=Khandaq demo contact (always-online Tox test peer for App Review and new users)
Documentation=https://github.com/ummalife/khandaq/tree/master/infra/demo-contact
After=network-online.target
Wants=network-online.target
# StartLimit* are only honoured in [Unit]. In [Service] systemd ignores them silently, and a crash
# loop then restarts forever (it happened on this host: 160 540 restarts of another service).
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=khandaq-demo
Group=khandaq-demo
ExecStart=/opt/khandaq-demo/bin/khandaq-demo --data /var/lib/khandaq-demo --assets /opt/khandaq-demo/assets --port 33445
Restart=on-failure
RestartSec=10

# The identity (Tox ID given to App Review) lives here and must survive every redeploy.
StateDirectory=khandaq-demo
StateDirectoryMode=0700

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
# Received files are held in memory until they are sent back: at most 6 at 20 MB each.
MemoryMax=384M
CPUQuota=150%
TasksMax=32

[Install]
WantedBy=multi-user.target
