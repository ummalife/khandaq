<?xml version="1.0" encoding="utf-8"?>
<!-- KHANDAQ (#10): shown while the profile databases are being re-encrypted with the new password. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboarding_form_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/khandaq_teal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/cp_rekey_running"
        android:textColor="@color/onboarding_title"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/cp_rekey_running_hint"
        android:textColor="@color/onboarding_hint"
        android:textSize="13sp" />

</LinearLayout>
