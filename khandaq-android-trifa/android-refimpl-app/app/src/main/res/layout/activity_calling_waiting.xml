<?xml version="1.0" encoding="utf-8"?>
<!-- KHANDAQ (redesign, E9; stage 3b; stage 5): waiting for someone offline before a call. The name, what
     the app is doing and Cancel, in white on the flat lock ground (lock-top) of the call screens, dark in
     both themes as on iOS; nothing moves while it waits (design/DESIGN.md, "Files, voice and calls on the
     phone"). The call starts on its own once the person is online. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_lock_top"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true"
    android:orientation="vertical"
    tools:context="com.zoffcc.applications.trifa.CallingWaitingActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/kq_space_24"
            android:paddingTop="@dimen/kq_space_48"
            android:paddingEnd="@dimen/kq_space_24"
            android:paddingBottom="@dimen/kq_space_24">

            <TextView
                android:id="@+id/call_waiting_friend_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.KQ.Display"
                android:textColor="@color/kq_fixed_white" />

            <ImageView
                android:layout_width="@dimen/kq_size_icon"
                android:layout_height="@dimen/kq_size_icon"
                android:layout_marginTop="@dimen/kq_space_24"
                android:importantForAccessibility="no"
                android:src="@drawable/kq_ic_clock"
                app:tint="@color/kq_fixed_white" />

            <TextView
                android:id="@+id/call_waiting_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kq_space_12"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.KQ.Body"
                android:textColor="@color/kq_fixed_white" />

            <TextView
                android:id="@+id/call_waiting_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kq_space_12"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.KQ.Label"
                android:textColor="@color/kq_fixed_white" />
        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/decline_waiting_button"
        android:layout_width="@dimen/kq_space_64"
        android:layout_height="@dimen/kq_space_64"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/air_bg_call_decline"
        android:contentDescription="@string/air_call_cancel"
        android:foreground="@drawable/air_ripple_on_lock"
        android:scaleType="center"
        android:src="@drawable/air_call_ic_end"
        app:tint="@color/kq_fixed_white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/kq_space_8"
        android:layout_marginBottom="@dimen/kq_space_32"
        android:importantForAccessibility="no"
        android:text="@string/air_call_cancel"
        android:textAppearance="@style/TextAppearance.KQ.Caption"
        android:textColor="@color/kq_fixed_white" />

</LinearLayout>
