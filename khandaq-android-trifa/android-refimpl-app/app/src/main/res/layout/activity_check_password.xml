<?xml version="1.0" encoding="utf-8"?>
<!-- KHANDAQ "Войти в профиль" (Figma 2031:9604): centered wordmark + title + password field + "Войти".
     Conservative restyle — keeps current login logic. Deviations from Figma (flagged): no "Имя" field
     (profile name isn't readable before unlock) and no "Создать профиль / Импорт профиля" links
     (multi-profile management is not in the current flow). All ids preserved for CheckPasswordActivity.java:
     login_progress_2, migration_text_01/02, login_form_2, password_1_c (TextInputEditText), set_button_2 (Button).
     No back arrow: login back is intentionally suppressed (onBackPressed). -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboarding_form_bg"
    android:fitsSystemWindows="true">

    <!-- Centered Khandaq wordmark -->
    <ImageView
        android:id="@+id/onboarding_logo"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:adjustViewBounds="true"
        android:src="@drawable/khandaq_wordmark"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/onboarding_login_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginHorizontal="16dp"
        android:text="@string/onboarding_login_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/onboarding_title"
        app:layout_constraintTop_toBottomOf="@id/onboarding_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Centered progress (kept) -->
    <ProgressBar
        android:id="@+id/login_progress_2"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Form -->
    <ScrollView
        android:id="@+id/login_form_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/onboarding_login_title"
        app:layout_constraintBottom_toTopOf="@id/login_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- DB migration warnings (kept; shown during migration) -->
            <TextView
                android:id="@+id/migration_text_01"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/layout___migdb_text"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/migration_text_02"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal"
                android:text="@string/layout___migdb_do_not_close"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_pw_label"
                android:textSize="16sp"
                android:textColor="@color/onboarding_title" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password_1_c"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_onboarding_field"
                android:paddingHorizontal="16dp"
                android:hint="@string/onboarding_pw_hint"
                android:textColorHint="@color/onboarding_hint"
                android:textColor="@color/onboarding_title"
                android:textSize="14sp"
                android:imeOptions="flagNoPersonalizedLearning"
                android:inputType="textPassword"
                android:maxLines="1"
                android:singleLine="true" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom action -->
    <LinearLayout
        android:id="@+id/login_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/set_button_2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_onboarding_btn"
            android:text="@string/onboarding_login_btn"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textColor="@android:color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
