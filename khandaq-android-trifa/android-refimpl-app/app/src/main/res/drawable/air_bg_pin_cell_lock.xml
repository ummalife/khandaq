<?xml version="1.0" encoding="utf-8"?>
<!-- KHANDAQ (redesign, stage 5): one cell of the PIN on the lock ground, as AirPinCell on iOS: translucent
     white (media-control) with no outline, and a white hairline on the cell the next digit goes into
     (activated). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kq_media_control" />
            <stroke android:width="@dimen/kq_stroke_hairline" android:color="@color/kq_fixed_white" />
            <corners android:radius="@dimen/kq_radius_field" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kq_media_control" />
            <corners android:radius="@dimen/kq_radius_field" />
        </shape>
    </item>
</selector>
