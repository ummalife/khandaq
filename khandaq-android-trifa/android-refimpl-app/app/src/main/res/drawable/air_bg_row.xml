<?xml version="1.0" encoding="utf-8"?>
<!-- An Air row: sunken while pressed, the focus ring under a keyboard, selected while chosen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="@integer/kq_dur_tap">
    <item android:state_pressed="true">
        <color android:color="@color/kq_sunken" />
    </item>
    <item android:state_focused="true">
        <inset android:inset="@dimen/kq_space_2">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <stroke android:width="@dimen/kq_stroke_focus" android:color="@color/kq_focus" />
                <corners android:radius="@dimen/kq_radius_field" />
            </shape>
        </inset>
    </item>
    <item android:state_activated="true">
        <color android:color="@color/kq_selected" />
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
