<?xml version="1.0" encoding="utf-8"?>
<!-- A filter pill: ink when it is the active filter, raised with a line otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="@integer/kq_dur_tap">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kq_ink" />
            <stroke android:width="@dimen/kq_stroke_focus" android:color="@color/kq_focus" />
            <corners android:radius="@dimen/kq_radius_round" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kq_ink" />
            <stroke android:width="@dimen/kq_stroke_hairline" android:color="@color/kq_ink" />
            <corners android:radius="@dimen/kq_radius_round" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kq_sunken" />
            <stroke android:width="@dimen/kq_stroke_hairline" android:color="@color/kq_line_strong" />
            <corners android:radius="@dimen/kq_radius_round" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kq_raised" />
            <stroke android:width="@dimen/kq_stroke_focus" android:color="@color/kq_focus" />
            <corners android:radius="@dimen/kq_radius_round" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kq_raised" />
            <stroke android:width="@dimen/kq_stroke_hairline" android:color="@color/kq_line_strong" />
            <corners android:radius="@dimen/kq_radius_round" />
        </shape>
    </item>
</selector>
