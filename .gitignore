khandaq-android-trifa/armeabi_build/
khandaq-android-trifa/x86_build/
khandaq-android-trifa/x86_64_build/
khandaq-android-trifa/artefacts/
# NDK toolchain installs (~3.7GB each, regenerated by the build)
