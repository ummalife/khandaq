<?xml version="1.0" encoding="utf-8"?>
<!-- KHANDAQ (#6): branded AlertDialog window background — rounded card on the form surface,
     inset so the dialog floats like the Figma modals (theme-aware via onboarding_form_bg). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp"
    android:insetTop="16dp"
    android:insetRight="16dp"
    android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/onboarding_form_bg" />
        <corners android:radius="20dp" />
    </shape>
</inset>
