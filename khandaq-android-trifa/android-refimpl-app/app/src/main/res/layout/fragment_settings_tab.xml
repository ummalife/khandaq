<?xml version="1.0" encoding="utf-8"?>
<!--
    KHANDAQ Settings (redesign, E18): one scrolling column that SettingsTabFragment fills with
    AirScreenKit sections, and the container the advanced preferences open in.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_bg">

    <ScrollView
        android:id="@+id/settings_tab_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/settings_tab_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/kq_space_16"
            android:paddingTop="@dimen/kq_space_8"
            android:paddingEnd="@dimen/kq_space_16"
            android:paddingBottom="@dimen/kq_space_32" />
    </ScrollView>

    <FrameLayout
        android:id="@+id/settings_tab_prefs_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kq_bg"
        android:visibility="gone" />

</FrameLayout>
