<?xml version="1.0" encoding="utf-8"?>
<!-- KHANDAQ (0.2.56, QA live 2026-11-14): the round button of a voice note, as AirPlayButton on the desktop
     and in Telegram: a 36dp disc, ink at rest, the hover and pressed inks under a pointer and a finger, sunken
     while the note cannot play, and the focus ring under a keyboard. The disc stands at the start of its
     48dp target, in line with the author and the texts of the column; the rest of the target reaches
     towards the wave and above and below it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="@dimen/kq_size_control"
        android:height="@dimen/kq_size_control"
        android:gravity="start|center_vertical">
        <selector android:exitFadeDuration="@integer/kq_dur_tap">
            <item android:state_enabled="false">
                <shape android:shape="oval">
                    <solid android:color="@color/kq_sunken" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="@color/kq_ink_pressed" />
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape android:shape="oval">
                    <solid android:color="@color/kq_ink_hover" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="oval">
                    <solid android:color="@color/kq_ink" />
                    <stroke android:width="@dimen/kq_stroke_focus" android:color="@color/kq_focus" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/kq_ink" />
                </shape>
            </item>
        </selector>
    </item>
</layer-list>
