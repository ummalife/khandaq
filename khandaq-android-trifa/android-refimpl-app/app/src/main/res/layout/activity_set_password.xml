<?xml version="1.0" encoding="utf-8"?>
<!-- KHANDAQ "Установить пароль" (Figma 2031:9582): app bar (← Назад) + centered logo + title +
     two rounded password fields with helper + primary "Создать"; secondary "Пропустить" kept.
     All view ids preserved for SetPasswordActivity.java (set_button/skip_button/import_profile_button
     stay <Button> — Java casts to Button; import button hidden, used by onboarding autostart-import). -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboarding_form_bg"
    android:fitsSystemWindows="true">

    <!-- App bar: back -->
    <LinearLayout
        android:id="@+id/onboarding_appbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/onboarding_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/onboarding_back"
            android:textSize="20sp"
            android:textColor="@color/onboarding_title" />
    </LinearLayout>

    <!-- Centered Khandaq logo -->
    <ImageView
        android:id="@+id/onboarding_logo"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:adjustViewBounds="true"
        android:src="@drawable/khandaq_wordmark"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@id/onboarding_appbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/onboarding_pw_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="16dp"
        android:text="@string/onboarding_pw_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/onboarding_title"
        app:layout_constraintTop_toBottomOf="@id/onboarding_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Centered progress (kept) -->
    <ProgressBar
        android:id="@+id/login_progress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Form -->
    <ScrollView
        android:id="@+id/login_form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/onboarding_pw_title"
        app:layout_constraintBottom_toTopOf="@id/onboarding_pw_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_pw_label"
                android:textSize="16sp"
                android:textColor="@color/onboarding_title" />

            <EditText
                android:id="@+id/password_1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_onboarding_field"
                android:paddingHorizontal="16dp"
                android:hint="@string/onboarding_pw_hint"
                android:textColorHint="@color/onboarding_hint"
                android:textColor="@color/onboarding_title"
                android:textSize="14sp"
                android:imeOptions="flagNoPersonalizedLearning"
                android:inputType="textPassword"
                android:maxLines="1"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/onboarding_pw_helper"
                android:textSize="14sp"
                android:lineSpacingExtra="2sp"
                android:textColor="@color/onboarding_desc" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/onboarding_pw_confirm_label"
                android:textSize="16sp"
                android:textColor="@color/onboarding_title" />

            <EditText
                android:id="@+id/password_2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_onboarding_field"
                android:paddingHorizontal="16dp"
                android:hint="@string/onboarding_pw_confirm_hint"
                android:textColorHint="@color/onboarding_hint"
                android:textColor="@color/onboarding_title"
                android:textSize="14sp"
                android:imeOptions="flagNoPersonalizedLearning"
                android:inputType="textPassword"
                android:maxLines="1"
                android:singleLine="true" />

            <!-- kept for build info (hidden); set in code -->
            <TextView
                android:id="@+id/githash_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textSize="11sp"
                android:textColor="@color/onboarding_hint"
                android:visibility="gone" />

            <!-- kept for onboarding autostart-import (hidden) -->
            <Button
                android:id="@+id/import_profile_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_import_tox_profile"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom actions -->
    <LinearLayout
        android:id="@+id/onboarding_pw_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/skip_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackground"
            android:text="@string/onboarding_skip"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="@color/onboarding_desc" />

        <Button
            android:id="@+id/set_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_onboarding_btn"
            android:text="@string/onboarding_create"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textColor="@android:color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
