# KHANDAQ (2026-08-23): regenerated for libvpx 1.14.1.
#
# The previous version of this patch was written in 2022 against a much older libvpx and no
# longer applied: the hunk targeted line ~869 while the block now sits at ~936, so patch(1)
# rejected it, and build_vpx.sh runs under set -e — the macOS dependency build died there,
# every time, before vpx/opus/ffmpeg/toxcore were built at all. That is why the desktop is
# still published at v0.2.12: it could not be built on a current macOS.
#
# The hunk itself is unchanged in intent — remove the -mmacosx-version-min case block, which
# pins ancient deployment targets (10.4-10.12) that fight the modern SDK. On darwin24 none of
# its branches match anyway, so this is dead code that only gets in the way.
--- libvpx/build/make/configure.sh	2026-08-23 22:47:20.592030429 +0300
+++ patched/build/make/configure.sh	2026-08-23 22:47:20.624174912 +0300
@@ -936,69 +936,6 @@
       ;;
   esac
 
-  case ${toolchain} in
-    *-darwin8-*)
-      add_cflags  "-mmacosx-version-min=10.4"
-      add_ldflags "-mmacosx-version-min=10.4"
-      ;;
-    *-darwin9-*)
-      add_cflags  "-mmacosx-version-min=10.5"
-      add_ldflags "-mmacosx-version-min=10.5"
-      ;;
-    *-darwin10-*)
-      add_cflags  "-mmacosx-version-min=10.6"
-      add_ldflags "-mmacosx-version-min=10.6"
-      ;;
-    *-darwin11-*)
-      add_cflags  "-mmacosx-version-min=10.7"
-      add_ldflags "-mmacosx-version-min=10.7"
-      ;;
-    *-darwin12-*)
-      add_cflags  "-mmacosx-version-min=10.8"
-      add_ldflags "-mmacosx-version-min=10.8"
-      ;;
-    *-darwin13-*)
-      add_cflags  "-mmacosx-version-min=10.9"
-      add_ldflags "-mmacosx-version-min=10.9"
-      ;;
-    *-darwin14-*)
-      add_cflags  "-mmacosx-version-min=10.10"
-      add_ldflags "-mmacosx-version-min=10.10"
-      ;;
-    *-darwin15-*)
