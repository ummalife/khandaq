<?xml version="1.0" encoding="utf-8"?>
<!-- KHANDAQ (26.11.2026): the members "@" offers, as Telegram does (DESIGN.md, "@ in a group"): Air's raised
     plate a little in from the edges, as high as its rows up to four and a half. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/kq_space_8"
    android:paddingEnd="@dimen/kq_space_8"
    android:paddingBottom="@dimen/kq_space_4">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/group_mention_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/air_bg_mention_list"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="@dimen/kq_space_4"
        android:paddingBottom="@dimen/kq_space_4"
        android:scrollbars="vertical" />

</FrameLayout>
