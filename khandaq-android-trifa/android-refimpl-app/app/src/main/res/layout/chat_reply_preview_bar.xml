<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_reply_preview_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tg_reply_preview_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp"
    android:visibility="gone">

    <View
        android:id="@+id/chat_reply_accent_bar"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:background="@color/tg_reply_preview_header"
        android:minHeight="36dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chat_reply_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/tg_reply_preview_header"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chat_reply_preview_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/tg_reply_preview_text"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/chat_reply_cancel"
        android:layout_width="@dimen/chat_input_icon_size"
        android:layout_height="@dimen/chat_input_icon_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/chat_reply_cancel"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_close_white_24dp"
        app:tint="@color/tg_reply_preview_text" />

</LinearLayout>
