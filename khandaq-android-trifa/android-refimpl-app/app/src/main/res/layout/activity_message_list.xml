<?xml version="1.0" encoding="utf-8"?>
<!--
    KHANDAQ (redesign, stage 2): the conversation with one person (design/redesign/02-plan.md, screens 5,
    6, 7, 10 and 16). From the top: the header (the person's tile, name and a chevron for the dossier, the
    call button and the overflow menu), the presence band (the link mark, the presence line and the day
    strip), the transcript, the "In transit" tray, the composer and the one-line hint under it. The
    dossier drops over everything below the band. Every id and onClick handler of the old layout is
    kept, so the activity and its helpers find the views they always did.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kq_surface"
    android:orientation="vertical"
    tools:context="com.zoffcc.applications.trifa.MessageListActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kq_surface"
        android:minHeight="?attr/actionBarSize"
        app:contentInsetStartWithNavigation="0dp"
        app:popupTheme="@style/KhandaqPopupOverlay"
        app:theme="@style/ThemeOverlay.KQ.Air.ChatBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="?attr/actionBarSize"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ml_header_profile_tap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/air_bg_icon_button"
                android:clickable="true"
                android:contentDescription="@string/message_list_open_friend_profile"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/kq_size_target_android"
                android:orientation="horizontal">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ml_avatar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/circle_red"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ml_icon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ml_status_icon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <com.zoffcc.applications.trifa.AirTileView
                    android:id="@+id/air_chat_tile"
                    android:layout_width="@dimen/air_header_tile"
                    android:layout_height="@dimen/air_header_tile"
                    android:layout_gravity="center_vertical" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/kq_space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/ml_maintext"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/layout___name"
                            android:textAlignment="viewStart"
                            android:textAppearance="@style/TextAppearance.KQ.Heading"
                            android:textColor="@color/kq_ink" />

                        <ImageView
                            android:id="@+id/air_chat_chevron"
                            android:layout_width="@dimen/kq_size_icon_small"
                            android:layout_height="@dimen/kq_size_icon_small"
                            android:layout_marginStart="@dimen/kq_space_4"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/kq_ic_chevron_down"
                            app:tint="@color/kq_ink_3" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ml_presence_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text=""
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.KQ.Caption"
                        android:textColor="@color/kq_ink_3"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- As on iOS: search, video and call are icons in the header, the call at the trailing edge.
                 Below 400dp the video call moves to the overflow so the name keeps about ten characters. -->
            <ImageButton
                android:id="@+id/ml_search_icon"
                android:layout_width="@dimen/kq_size_target_android"
                android:layout_height="@dimen/kq_size_target_android"
                android:layout_gravity="center_vertical"
                android:background="@drawable/air_bg_icon_button"
                android:contentDescription="@string/chat_action_search"
                android:scaleType="center"
                android:src="@drawable/kq_ic_search"
                app:tint="@color/air_icon_button_tint" />

            <ImageButton
                android:id="@+id/ml_video_icon"
                android:layout_width="@dimen/kq_size_target_android"
                android:layout_height="@dimen/kq_size_target_android"
                android:layout_gravity="center_vertical"
                android:background="@drawable/air_bg_icon_button"
                android:clickable="true"
                android:contentDescription="@string/chat_action_video"
                android:onClick="start_call_to_friend"
                android:scaleType="center"
                android:src="@drawable/kq_ic_video"
                android:visibility="gone"
                app:tint="@color/air_icon_button_tint" />

            <ImageButton
                android:id="@+id/ml_phone_icon"
                android:layout_width="@dimen/kq_size_target_android"
                android:layout_height="@dimen/kq_size_target_android"
                android:layout_gravity="center_vertical"
                android:background="@drawable/air_bg_icon_button"
                android:clickable="true"
                android:contentDescription="@string/title_activity_calling"
                android:onClick="start_audio_call_to_friend"
                android:scaleType="center"
                android:src="@drawable/kq_ic_phone"
                app:tint="@color/air_icon_button_tint" />

            <!-- Search opens from its icon and fills the row while it is open. -->
            <androidx.appcompat.widget.SearchView
                android:id="@+id/search_view_messages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:focusable="false"
                android:visibility="gone"
                app:iconifiedByDefault="false" />

            <!-- The message filter runs from the overflow menu; the spinner keeps its selection logic. -->
            <com.zoffcc.applications.trifa.CustomSpinner
                android:id="@+id/spinner_filter_msgs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/chat_filter_spinner_description"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- The presence band: tapping it opens the dossier, like the name does. -->
    <LinearLayout
        android:id="@+id/air_chat_band"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/air_bg_band"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/kq_space_16"
        android:paddingTop="@dimen/kq_space_6"
        android:paddingEnd="@dimen/kq_space_16"
        android:paddingBottom="@dimen/kq_space_10"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.zoffcc.applications.trifa.AirLinkMarkView
                android:id="@+id/air_chat_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/air_chat_presence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/kq_space_8"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.KQ.Caption"
                android:textColor="@color/kq_ink_2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kq_space_6"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.zoffcc.applications.trifa.AirDayStripView
                android:id="@+id/air_chat_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/air_chat_strip_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/kq_space_10"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.KQ.Caption"
                android:textColor="@color/kq_ink_3" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/air_chat_rule"
        android:layout_width="match_parent"
        android:layout_height="@dimen/kq_stroke_hairline"
        android:background="@color/kq_line" />

    <FrameLayout
        android:id="@+id/air_chat_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/air_chat_conversation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <fragment
                    android:id="@+id/ml_fragment"
                    android:name="com.zoffcc.applications.trifa.MessageListFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:layout="@layout/message_list_layout" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ml_friend_typing"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/kq_ink_2" />
            </LinearLayout>

            <include layout="@layout/chat_reply_preview_bar" />

            <!-- The "In transit" tray: what waits on this device while the person is offline. -->
            <LinearLayout
                android:id="@+id/air_tray"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/kq_space_12"
                android:layout_marginEnd="@dimen/kq_space_12"
                android:layout_marginBottom="@dimen/kq_space_10"
                android:background="@drawable/air_bg_tray"
                android:orientation="vertical"
                android:paddingStart="@dimen/kq_space_12"
                android:paddingTop="@dimen/kq_space_8"
                android:paddingEnd="@dimen/kq_space_12"
                android:paddingBottom="@dimen/kq_space_6"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/air_tray_head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/air_bg_icon_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/kq_size_control"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/air_tray_clock"
                        android:layout_width="@dimen/kq_size_icon_small"
                        android:layout_height="@dimen/kq_size_icon_small"
                        android:layout_marginEnd="@dimen/kq_space_8"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/kq_ic_clock"
                        app:tint="@color/kq_transit" />

                    <TextView
                        android:id="@+id/air_tray_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.KQ.Label"
                        android:textColor="@color/kq_transit" />

                    <ImageView
                        android:id="@+id/air_tray_chevron"
                        android:layout_width="@dimen/kq_size_icon_small"
                        android:layout_height="@dimen/kq_size_icon_small"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/kq_ic_chevron_down"
                        app:tint="@color/kq_ink_3" />
                </LinearLayout>

                <TextView
                    android:id="@+id/air_tray_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/kq_space_4"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.KQ.Caption"
                    android:textColor="@color/kq_ink_2"
                    android:visibility="gone" />

                <com.zoffcc.applications.trifa.AirCappedScrollView
                    android:id="@+id/air_tray_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/air_tray_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </com.zoffcc.applications.trifa.AirCappedScrollView>
            </LinearLayout>

            <!-- The buttons are 48dp touch targets whose plates (air_bg_composer_button, the send plate) are
                 as tall as the 40dp field; the field's 4dp margins line it up with those plates. -->
            <FrameLayout
                android:id="@+id/emoji_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/air_bg_composer"
                android:paddingStart="@dimen/kq_space_4"
                android:paddingTop="@dimen/kq_space_4"
                android:paddingEnd="@dimen/kq_space_4">

                <LinearLayout
                    android:id="@+id/emoji_bar_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/ml_button_01"
                        android:layout_width="@dimen/kq_size_target_android"
                        android:layout_height="@dimen/kq_size_target_android"
                        android:background="@drawable/air_bg_composer_button"
                        android:clickable="true"
                        android:contentDescription="@string/air_compose_attach"
                        android:scaleType="center"
                        android:src="@drawable/kq_ic_plus"
                        app:tint="@color/air_icon_button_tint" />

                    <FrameLayout
                        android:id="@+id/air_compose_field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/kq_space_4"
                        android:layout_marginBottom="@dimen/kq_space_4"
                        android:layout_weight="1"
                        android:addStatesFromChildren="true"
                        android:background="@drawable/air_bg_field"
                        android:minHeight="@dimen/kq_size_field">

                        <com.vanniktech.emoji.EmojiEditText
                            android:id="@+id/ml_new_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:background="@android:color/transparent"
                            android:backgroundTint="@null"
                            android:cursorVisible="true"
                            android:gravity="center_vertical|start"
                            android:hint="@string/air_compose_placeholder"
                            android:imeOptions="flagNoPersonalizedLearning|actionSend"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLines="5"
                            android:paddingStart="@dimen/kq_space_12"
                            android:paddingTop="@dimen/kq_space_8"
                            android:paddingEnd="@dimen/kq_space_12"
                            android:paddingBottom="@dimen/kq_space_8"
                            android:includeFontPadding="false"
                            android:minHeight="@dimen/kq_size_field"
                            android:singleLine="false"
                            android:text=""
                            android:textAlignment="viewStart"
                            android:textAppearance="@style/TextAppearance.KQ.Body"
                            android:textColor="@color/kq_ink"
                            android:textColorHint="@color/kq_ink_3" />
                    </FrameLayout>

                    <ImageButton
                        android:id="@+id/insert_emoji"
                        android:layout_width="@dimen/kq_size_target_android"
                        android:layout_height="@dimen/kq_size_target_android"
                        android:background="@drawable/air_bg_composer_button"
                        android:scaleType="center"
                        app:srcCompat="@drawable/i_emoji_google_category_people"
                        app:tint="@color/air_icon_button_tint"
                        tools:ignore="ContentDescription" />

                    <ImageButton
                        android:id="@+id/ml_button_recaudio"
                        android:layout_width="@dimen/kq_size_target_android"
                        android:layout_height="@dimen/kq_size_target_android"
                        android:background="@drawable/air_bg_composer_button"
                        android:contentDescription="@string/air_compose_voice"
                        android:scaleType="center"
                        android:src="@drawable/kq_ic_mic"
                        app:tint="@color/kq_ink_2" />
                </LinearLayout>

                <include layout="@layout/chat_voice_recording_bar" />
            </FrameLayout>

            <!-- What happens to a message sent now, and the room left in it once it runs short. -->
            <LinearLayout
                android:id="@+id/air_compose_hint_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/kq_surface"
                android:gravity="center_vertical"
                android:minHeight="@dimen/kq_size_control_small"
                android:orientation="horizontal"
                android:paddingStart="@dimen/kq_space_16"
                android:paddingEnd="@dimen/kq_space_16"
                android:paddingBottom="@dimen/kq_space_4">

                <View
                    android:id="@+id/air_compose_dot"
                    android:layout_width="@dimen/kq_size_dot"
                    android:layout_height="@dimen/kq_size_dot"
                    android:layout_marginEnd="@dimen/kq_space_8"
                    android:background="@drawable/air_bg_dot"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/air_compose_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.KQ.Caption"
                    android:textColor="@color/kq_ink_2" />

                <TextView
                    android:id="@+id/air_compose_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/kq_space_8"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="2"
                    android:textAlignment="viewEnd"
                    android:textAppearance="@style/TextAppearance.KQ.Caption"
                    android:textColor="@color/kq_ink_3"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/air_dossier_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/kq_scrim"
            android:clickable="true"
            android:contentDescription="@string/air_dossier_close_hint"
            android:focusable="false"
            android:visibility="gone" />

        <include layout="@layout/air_dossier" />
    </FrameLayout>
</LinearLayout>
