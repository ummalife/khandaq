<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_attach_sheet"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_onboarding_dot_track" />

    <TextView
        android:id="@+id/attach_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginBottom="16dp"
        android:text="@string/attach_option_title"
        android:textColor="@color/onboarding_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- KHANDAQ (redesign, E8): a group says its file limit before a file is chosen. -->
    <TextView
        android:id="@+id/attach_sheet_limit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="-8dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="16dp"
        android:textAppearance="@style/TextAppearance.KQ.Caption"
        android:textColor="@color/kq_ink_2"
        android:visibility="gone" />

    <!-- KHANDAQ (0.2.56): holds the grid's place while the recent media are read (off the main thread). -->
    <FrameLayout
        android:id="@+id/attach_media_loading"
        android:layout_width="match_parent"
        android:layout_height="232dp"
        android:layout_marginBottom="14dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>

    <!-- KHANDAQ (tester 23.11): the grid and the Send of a selection share one frame. The button floats over the
         grid's lower corner instead of waiting under the chips, so it is on screen with the photos however short
         the phone, and choosing a photo does not make the sheet taller. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Figma attachments grid: recent device media; tap routes into the send preview. The bottom padding
             lets the last row scroll clear of the button. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/attach_media_grid"
            android:layout_width="match_parent"
            android:layout_height="232dp"
            android:layout_marginBottom="14dp"
            android:clipToPadding="false"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:paddingBottom="64dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/attach_send_selected"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="26dp"
            android:background="@drawable/bg_onboarding_btn"
            android:elevation="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- KHANDAQ (tester 23.11): each name keeps to one line and shrinks to fit a fifth of a narrow screen or large
         text, instead of wrapping and making the row taller. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5">

        <LinearLayout
            android:id="@+id/attach_chip_camera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/attach_chip_camera_icon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_attach_chip_circle"
                android:padding="15dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/attach_chip_camera"
                android:textColor="@color/onboarding_title"
                android:textSize="13sp"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/attach_chip_video"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/attach_chip_video_icon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_attach_chip_circle"
                android:padding="15dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/attach_chip_video"
                android:textColor="@color/onboarding_title"
                android:textSize="13sp"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/attach_chip_gallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/attach_chip_gallery_icon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_attach_chip_circle"
                android:padding="15dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/attach_option_gallery"
                android:textColor="@color/onboarding_title"
                android:textSize="13sp"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <!-- KHANDAQ (Figma): "Файл" — send any document (user request; the design's attach has it). -->
        <LinearLayout
            android:id="@+id/attach_chip_file"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/attach_chip_file_icon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_attach_chip_circle"
                android:padding="15dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/attach_option_file"
                android:textColor="@color/onboarding_title"
                android:textSize="13sp"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <!-- KHANDAQ (#T2): share current location as a map bubble (parity with iOS). -->
        <LinearLayout
            android:id="@+id/attach_chip_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/attach_chip_location_icon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_attach_chip_circle"
                android:padding="15dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/attach_location"
                android:textColor="@color/onboarding_title"
                android:textSize="13sp"
                app:autoSizeMaxTextSize="13sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
