<?xml version="1.0" encoding="utf-8"?>
<!-- KHANDAQ (redesign, stage 3b; stage 5): the 64dp circle of Answer and With video, filled green with a
     white glyph in both themes; the focus ring under a keyboard is white, so it shows on the lock ground. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="@integer/kq_dur_tap">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/kq_live_fill" />
            <stroke android:width="@dimen/kq_stroke_focus" android:color="@color/kq_fixed_white" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/kq_live_fill" />
        </shape>
    </item>
</selector>
