<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tg_chat_bg"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/notification_ringtone_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        app:navigationContentDescription="@string/abc_action_bar_up_description"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/pref_title_ringtone"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/notification_volume_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_title_notification_volume"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/notification_volume_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="100" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/md_grey_300_seperator" />

    <ListView
        android:id="@+id/notification_ringtone_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/tg_chat_bg"
        android:choiceMode="singleChoice"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:divider="@color/md_grey_300_seperator"
        android:dividerHeight="0.5dp"
        android:scrollbars="vertical" />

</LinearLayout>
