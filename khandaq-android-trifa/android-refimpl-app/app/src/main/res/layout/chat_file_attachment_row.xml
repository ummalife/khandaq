<?xml version="1.0" encoding="utf-8"?>
<!--
    KHANDAQ (redesign, stage 3b): a file in the transcript, as AirFileRowView on iOS (design/DESIGN.md,
    "Files, voice and calls on the phone"): the file glyph, the name and the size on one line; under
    them the 6dp bar while it moves, one line of state in words and the actions in words. Under a photo
    or a voice note the first line is gone: the preview already says what the file is.
    The ids the transfer helpers look up are kept (ft_file_attachment_row, ft_file_icon, ft_file_name,
    ft_file_size, ft_file_progress, ft_file_progress_detail, ft_file_error, and the old ft_file_cancel
    and ft_file_retry buttons, which stay hidden); AirFileEntry draws the row and wires its actions.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ft_file_attachment_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/air_file_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/kq_size_icon"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ft_file_icon"
            android:layout_width="@dimen/kq_size_icon"
            android:layout_height="@dimen/kq_size_icon"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/kq_ic_file"
            android:tint="@color/kq_ink_2" />

        <TextView
            android:id="@+id/ft_file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/kq_space_10"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:importantForAccessibility="no"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.KQ.Air.LabelStrong"
            android:textColor="@color/kq_ink" />

        <TextView
            android:id="@+id/ft_file_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/kq_space_10"
            android:fontFeatureSettings="tnum"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.KQ.Caption"
            android:textColor="@color/kq_ink_3" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/ft_file_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/kq_size_bar"
        android:layout_marginTop="@dimen/kq_space_6"
        android:importantForAccessibility="no"
        android:indeterminate="false"
        android:max="1000"
        android:progressDrawable="@drawable/air_file_bar"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ft_file_progress_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kq_space_6"
        android:fontFeatureSettings="tnum"
        android:importantForAccessibility="no"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.KQ.Caption"
        android:textColor="@color/kq_ink_3"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ft_file_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kq_space_6"
        android:importantForAccessibility="no"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.KQ.Caption"
        android:textColor="@color/kq_danger"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/air_file_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/air_file_accept"
            style="@style/Widget.KQ.Air.FileAction"
            android:text="@string/air_file_accept"
            android:textColor="@color/kq_ink" />

        <TextView
            android:id="@+id/air_file_retry"
            style="@style/Widget.KQ.Air.FileAction"
            android:text="@string/air_file_retry_incoming"
            android:textColor="@color/kq_ink" />

        <TextView
            android:id="@+id/air_file_decline"
            style="@style/Widget.KQ.Air.FileAction"
            android:text="@string/air_file_decline" />

        <TextView
            android:id="@+id/air_file_cancel"
            style="@style/Widget.KQ.Air.FileAction"
            android:text="@string/air_file_cancel" />

        <TextView
            android:id="@+id/air_file_save"
            style="@style/Widget.KQ.Air.FileAction"
            android:text="@string/air_file_save"
            android:textColor="@color/kq_ink" />

        <TextView
            android:id="@+id/air_file_share"
            style="@style/Widget.KQ.Air.FileAction"
            android:text="@string/air_file_share" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/ft_file_cancel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@null"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/ft_file_retry"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@null"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</LinearLayout>
