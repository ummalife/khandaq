<?xml version="1.0" encoding="utf-8"?>
<!--
    KHANDAQ (redesign, stage 3b): a file, a photo, a video or a voice note as an entry of the transcript
    (design/DESIGN.md, "Files, voice and calls on the phone"), framed like air_entry_text: the time in
    its column, the author over the first entry of a run, the content, and the mark of our own at the
    far end. No bubble, no avatar and no wallpaper. AirFileEntry draws it after the row holder; every id
    the holders and the transfer helpers look up is kept, the old chrome stays hidden.
    The compact layout is the same entry: an entry is already compact.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/message_text_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/air_entry_text_start"
        android:paddingTop="@dimen/kq_space_12"
        android:paddingEnd="@dimen/kq_space_16"
        android:paddingBottom="@dimen/kq_space_4"
        android:visibility="gone">

        <TextView
            android:id="@+id/message_text_date_string"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.KQ.Air.CaptionMedium"
            android:textColor="@color/kq_ink_3" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_message_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/kq_space_16"
        android:paddingTop="@dimen/air_entry_inset"
        android:paddingEnd="@dimen/kq_space_16"
        android:paddingBottom="@dimen/air_entry_inset">

        <TextView
            android:id="@+id/date_time"
            android:layout_width="@dimen/kq_size_time_column_phone"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.KQ.Caption"
            android:textColor="@color/kq_ink_3" />

        <LinearLayout
            android:id="@+id/air_file_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/kq_space_10"
            android:layout_marginEnd="@dimen/kq_space_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/air_file_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.KQ.Air.LabelStrong"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layout_peer_name_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/peer_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.KQ.Air.LabelStrong" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/air_file_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/img_avatar"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/img_corner"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/m_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.luseen.autolinklibrary.EmojiTextViewLinks
                        android:id="@+id/m_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.KQ.Body"
                        android:textColor="@color/kq_ink"
                        android:textColorLink="@color/kq_ink"
                        android:visibility="gone"
                        app:emojiSize="@dimen/emoji_size_in_textview" />

                    <com.daimajia.numberprogressbar.NumberProgressBar
                        android:id="@+id/ft_progressbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:progress_max="100"
                        app:progress_reached_bar_height="@dimen/kq_size_bar"
                        app:progress_reached_color="@color/kq_ink"
                        app:progress_text_visibility="invisible"
                        app:progress_unreached_bar_height="@dimen/kq_size_bar"
                        app:progress_unreached_color="@color/kq_sunken" />

                    <LinearLayout
                        android:id="@+id/ft_preview_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <me.jagar.chatvoiceplayerlibrary.vVoicePlayerView
                            android:id="@+id/ft_audio_player"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:enableVisualizer="true"
                            app:playPauseBackgroundColor="@android:color/transparent"
                            app:playPauseCornerRadius="0"
                            app:playProgressbarColor="@color/kq_ink_3"
                            app:progressTimeColor="@color/kq_ink_3"
                            app:seekBarProgressColor="@color/kq_ink"
                            app:seekBarThumbColor="@color/kq_ink"
                            app:shareBackgroundColor="@android:color/transparent"
                            app:shareCornerRadius="0"
                            app:showShareButton="false"
                            app:showTiming="true"
                            app:timingBackgroundColor="@android:color/transparent"
                            app:viewBackground="@android:color/transparent"
                            app:viewCornerRadius="0"
                            app:visualizationNotPlayedColor="@color/kq_line_strong"
                            app:visualizationPlayedColor="@color/kq_ink" />

                        <ImageButton
                            android:id="@+id/ft_preview_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="false"
                            android:background="@drawable/air_file_photo_ground"
                            android:contentDescription="@null"
                            android:minHeight="1dp"
                            android:padding="0dp"
                            android:scaleType="centerCrop"
                            android:src="@null"
                            android:visibility="gone" />

                        <include layout="@layout/chat_file_attachment_row" />

                        <com.luseen.autolinklibrary.EmojiTextViewLinks
                            android:id="@+id/ft_caption_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/kq_space_6"
                            android:autoLink="web"
                            android:textAlignment="viewStart"
                            android:textAppearance="@style/TextAppearance.KQ.Body"
                            android:textColor="@color/kq_ink"
                            android:textColorLink="@color/kq_ink"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ft_export_button_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageButton
                            android:id="@+id/ft_export_button"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="@null"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/ft_share_button"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="@null"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ft_buttons_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageButton
                            android:id="@+id/ft_button_ok"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="@null"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/ft_dummy1"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="@null"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/ft_button_cancel"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="@null"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:visibility="gone" />
                    </LinearLayout>

                    <include layout="@layout/chat_reactions_row" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/m_icon"
            android:layout_width="@dimen/kq_size_mark"
            android:layout_height="@dimen/kq_size_mark"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:visibility="invisible" />
    </LinearLayout>
</LinearLayout>
