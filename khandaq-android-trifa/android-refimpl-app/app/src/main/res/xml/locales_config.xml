<?xml version="1.0" encoding="utf-8"?>
<!--
    The languages the app ships translations for, the same four as resConfigs in build.gradle and
    AppLocaleHelper.SUPPORTED_LANG_CODES. The system's per-app language setting offers exactly these.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ru" />
    <locale android:name="ar" />
    <locale android:name="zh-CN" />
</locale-config>
