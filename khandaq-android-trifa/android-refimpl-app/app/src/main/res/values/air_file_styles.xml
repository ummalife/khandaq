<?xml version="1.0" encoding="utf-8"?>
<!-- KHANDAQ (redesign, stage 3b): the quiet actions of a file entry, words in the label size, a finger high. -->
<resources>

    <style name="Widget.KQ.Air.FileAction" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/kq_size_target_android</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">@dimen/kq_space_16</item>
        <item name="android:maxLines">2</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textAppearance">@style/TextAppearance.KQ.Label</item>
        <item name="android:textColor">@color/kq_ink_2</item>
        <item name="android:background">@null</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- The voice note's Listen and Pause: the ink button of the design, in the label size. -->
    <style name="Widget.KQ.Air.VoiceButton" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/kq_size_control</item>
        <item name="android:minWidth">@dimen/kq_size_target_android</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/kq_space_16</item>
        <item name="android:paddingEnd">@dimen/kq_space_16</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/TextAppearance.KQ.Label</item>
        <item name="android:textColor">@color/kq_ink</item>
        <item name="android:background">@drawable/air_bg_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
