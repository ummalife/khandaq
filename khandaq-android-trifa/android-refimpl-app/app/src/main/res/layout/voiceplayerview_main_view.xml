<?xml version="1.0" encoding="utf-8"?>
<!--
    KHANDAQ (redesign, stage 3b): a voice note is a player, as ChatVoiceMessageView on iOS (design/DESIGN.md,
    "Files, voice and calls on the phone"): Listen and Pause, the wave that fills in ink as it
    plays, and the length in tabular figures at the end, the time played while it plays.
    0.2.56 (QA live): Listen and Pause are a round play button, as in Telegram and on the desktop; the
    words are what TalkBack says. The rest of the button's target is the gap before the wave.
    The ids the player classes look up are kept.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/collectorLinearLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/paddedLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/kq_size_target_android"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/imgPlay"
            style="@style/Widget.KQ.Air.VoiceButton"
            android:contentDescription="@string/air_voice_listen"
            android:src="@drawable/air_voice_ic_play" />

        <ProgressBar
            android:id="@+id/pb_play"
            android:layout_width="@dimen/kq_size_control"
            android:layout_height="@dimen/kq_size_control"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/imgPause"
            style="@style/Widget.KQ.Air.VoiceButton"
            android:contentDescription="@string/air_voice_pause"
            android:src="@drawable/air_voice_ic_pause"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/containerLinearLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/kq_space_10"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <me.jagar.chatvoiceplayerlibrary.PlayerVisualizerSeekbar
                android:id="@+id/seekBarV"
                android:layout_width="match_parent"
                android:layout_height="@dimen/kq_size_control_small"
                android:layout_gravity="center"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.KQ.Caption"
            android:textColor="@color/kq_ink_3" />

        <!-- Testers' ideas (0.2.67): the speed of voice notes, 1x, 1.5x or 2x, on the note that plays or waits
             paused midway; a tap goes to the next one for every note (VoicePlaybackSpeed). A raised pill with a
             line, drawn 28dp high in the 48dp target, growing with the text size. -->
        <TextView
            android:id="@+id/txtSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/kq_space_6"
            android:background="@drawable/air_bg_voice_speed"
            android:clickable="true"
            android:focusable="true"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="@dimen/kq_size_target_android"
            android:minHeight="@dimen/kq_size_target_android"
            android:paddingStart="@dimen/kq_space_10"
            android:paddingTop="@dimen/kq_space_12"
            android:paddingEnd="@dimen/kq_space_10"
            android:paddingBottom="@dimen/kq_space_12"
            android:textAppearance="@style/TextAppearance.KQ.Air.CaptionStrong"
            android:textColor="@color/kq_ink_2"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgShare"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="@dimen/kq_size_control"
            android:layout_height="@dimen/kq_size_control"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
