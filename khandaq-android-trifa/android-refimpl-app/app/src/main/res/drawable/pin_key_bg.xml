<?xml version="1.0" encoding="utf-8"?>
<!-- KHANDAQ PIN keypad key: round light-grey key, faint teal fill while pressed (Figma and_pin_*). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/pin_key_bg_pressed" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/pin_key_bg" />
        </shape>
    </item>
</selector>
