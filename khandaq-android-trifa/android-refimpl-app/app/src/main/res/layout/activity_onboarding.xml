<?xml version="1.0" encoding="utf-8"?>
<!-- KHANDAQ onboarding (Figma "Онбординг"): 3 intro slides with a top step indicator and a bottom
     action area (Далее / Создать аккаунт + Импорт профиля). Slide content swaps in code (no
     ViewPager2 dependency); horizontal swipe + button drive navigation.
     NOTE: uses the system sans-serif font (Roboto) — bundling Inter/Geist app-wide is a follow-up. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboarding_bg"
    android:fitsSystemWindows="true">

    <!-- Step indicator (3 segments) -->
    <LinearLayout
        android:id="@+id/onboarding_progress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/onboarding_dot_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_onboarding_dot_active" />

        <View
            android:id="@+id/onboarding_dot_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_onboarding_dot_track" />

        <View
            android:id="@+id/onboarding_dot_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_onboarding_dot_track" />
    </LinearLayout>

    <!-- Bottom action area -->
    <LinearLayout
        android:id="@+id/onboarding_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/onboarding_btn_secondary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_onboarding_btn_secondary"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="@color/onboarding_title"
            android:text="@string/onboarding_import_profile"
            android:visibility="gone" />

        <TextView
            android:id="@+id/onboarding_btn_primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_onboarding_btn"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:text="@string/onboarding_next" />
    </LinearLayout>

    <!-- Slide content (swapped in code) -->
    <LinearLayout
        android:id="@+id/onboarding_slide"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/onboarding_progress"
        app:layout_constraintBottom_toTopOf="@id/onboarding_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.0" />

        <ImageView
            android:id="@+id/onboarding_illustration"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.1" />

        <TextView
            android:id="@+id/onboarding_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4sp"
            android:textColor="@color/onboarding_title" />

        <TextView
            android:id="@+id/onboarding_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            android:lineSpacingExtra="2sp"
            android:textColor="@color/onboarding_desc" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
