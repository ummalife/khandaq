<resources>

    <!-- KHANDAQ splash: launcher windowBackground = centered wordmark on form bg (day/night) -->
    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>

    <!-- KHANDAQ bottom-nav active indicator pill (Figma: pale teal behind the active item) -->
    <style name="KhandaqNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/khandaq_nav_indicator</item>
    </style>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <!-- KHANDAQ: status bar matches toolbar (neutral), not off-brand green colorPrimaryDark -->
        <item name="android:statusBarColor">@color/tg_chat_header_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>
        <item name="patternViewStyle">@style/PatternView</item>
        <item name="android:actionModeBackground">@color/md_orange_400</item>
        <item name="windowActionModeOverlay">true</item>

        <item name="material_drawer_background">@color/khandaq_surface</item>
        <item name="material_drawer_primary_text">@color/khandaq_text</item>
        <item name="material_drawer_primary_icon">@color/gray</item>

        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@color/gray</item>

        <item name="textAppearanceHeadline6">@style/TextAppearance.Khandaq.Headline</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Khandaq.Body</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Khandaq.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.Khandaq.Button</item>
        <item name="toolbarStyle">@style/Khandaq.Toolbar</item>
        <item name="textInputStyle">@style/Widget.Khandaq.TextInputLayout</item>

    </style>

    <style name="SettingsTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:textColorPrimary">@color/md_always_black_1000</item>
        <item name="android:textColorSecondary">@color/gray</item>
    </style>

    <style name="FullscreenTheme" parent="AppTheme">
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
        <item name="metaButtonBarStyle">?android:attr/buttonBarStyle</item>
        <item name="metaButtonBarButtonStyle">?android:attr/buttonBarButtonStyle</item>
    </style>

    <style name="QrScanTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="DrawerArrowStyle" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="spinBars">true</item>
        <item name="color">@color/tg_chat_title</item>
    </style>

    <!-- KHANDAQ PIN keypad digit key (round grey key, Figma and_pin_*) -->
    <style name="PinKey">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:background">@drawable/pin_key_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/onboarding_title</item>
        <item name="android:textSize">24sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>


    <!--<style name="MainActyActionBar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">-->
    <!--<item name="contentInsetStart">0dp</item>-->
    <!--<item name="contentInsetStartWithNavigation">0dp</item>-->
