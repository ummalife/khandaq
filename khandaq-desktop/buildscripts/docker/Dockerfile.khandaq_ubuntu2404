# Khandaq Linux build image — Ubuntu 24.04
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# KHANDAQ (desktop v0.2.49): FFmpeg is built from source below (build_ffmpeg_linux.sh), so Ubuntu's
# FFmpeg 6.1.1 development packages are gone, and with them the codec libraries (dav1d, x265, AOM,
# LAME, VA-API and the rest) that were here only because its pkg-config files require them. Nothing
# else in the build uses them; nasm and the xcb packages are what the FFmpeg build needs.
RUN apt-get update && apt-get -y --no-install-recommends install \
    build-essential \
    autoconf \
    automake \
    libtool \
    cmake \
    extra-cmake-modules \
    git \
    pkg-config \
    nasm \
    libexif-dev \
    libgdk-pixbuf2.0-dev \
    libglib2.0-dev \
    libgtk2.0-dev \
    libopenal-dev \
    libopus-dev \
    libqrencode-dev \
    libqt5opengl5-dev \
    libqt5svg5-dev \
    libsodium-dev \
    libsqlcipher-dev \
    libvpx-dev \
    libx264-dev \
    libxcb1-dev \
    libxcb-shape0-dev \
    libxcb-shm0-dev \
    libxcb-xfixes0-dev \
    zlib1g-dev \
    librsvg2-dev \
    libxss-dev \
    qtbase5-dev \
    qttools5-dev \
    qttools5-dev-tools \
    librsvg2-bin \
    ca-certificates \
    curl \
    file \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY download/common.sh /build/download/common.sh
# KHANDAQ (desktop v0.2.49): before toxcore, which links libavcodec and libavutil.
COPY build_ffmpeg_linux.sh /build/build_ffmpeg_linux.sh
RUN mkdir -p /src/ffmpeg && cd /src/ffmpeg && /build/build_ffmpeg_linux.sh && rm -rf /src/ffmpeg
COPY build_utils.sh /build/build_utils.sh
COPY download/download_toxcore.sh /build/download/download_toxcore.sh
COPY download/download_toxext.sh /build/download/download_toxext.sh
COPY download/download_toxext_messages.sh /build/download/download_toxext_messages.sh
COPY build_toxcore_linux.sh /build/build_toxcore_linux.sh
# KHANDAQ (v0.2.48): build the toxcore committed under buildscripts/toxcore, the copy that has the
# toxav length checks (scripts/check-audio-length-gate.py) and that the macOS build uses. With
# /src/tox empty, download_toxcore.sh cloned upstream 2e7a0675, which has none of them; with the
# copy in place it skips the clone.
COPY toxcore /src/tox/toxcore

RUN mkdir -p /src/tox && cd /src/tox && \
    sed -i 's/cmake \./cmake -DCMAKE_POLICY_VERSION_MINIMUM=3.5 ./g' /build/build_toxcore_linux.sh && \
    /build/build_toxcore_linux.sh && \
    rm -rf /src/tox

RUN echo '/usr/local/lib/' >> /etc/ld.so.conf.d/locallib.conf && ldconfig

WORKDIR /khandaq
