<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_attach_sheet"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_onboarding_dot_track" />

    <TextView
        android:id="@+id/attach_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginBottom="16dp"
        android:text="@string/attach_option_title"
        android:textColor="@color/onboarding_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Figma attachments grid: recent device media; tap routes into the send preview. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/attach_media_grid"
        android:layout_width="match_parent"
        android:layout_height="232dp"
        android:layout_marginBottom="14dp"
        android:clipToPadding="false"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:id="@+id/attach_chip_camera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/attach_chip_camera_icon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_attach_chip_circle"
                android:padding="15dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/attach_chip_camera"
                android:textColor="@color/onboarding_title"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/attach_chip_video"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/attach_chip_video_icon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_attach_chip_circle"
                android:padding="15dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/attach_chip_video"
                android:textColor="@color/onboarding_title"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/attach_chip_gallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/attach_chip_gallery_icon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_attach_chip_circle"
                android:padding="15dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/attach_option_gallery"
                android:textColor="@color/onboarding_title"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- KHANDAQ (Figma): "Файл" — send any document (user request; the design's attach has it). -->
        <LinearLayout
            android:id="@+id/attach_chip_file"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/attach_chip_file_icon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_attach_chip_circle"
                android:padding="15dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/attach_option_file"
                android:textColor="@color/onboarding_title"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/attach_send_selected"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_onboarding_btn"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
